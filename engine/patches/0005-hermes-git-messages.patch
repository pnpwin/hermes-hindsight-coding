+/** Narrow adapter surface: this runner is supplied by the host and operates on one pinned view. */
+export function renderGitMessageWindow(read: (...args: string[]) => string, revision: string, limit: number): string {
+  const total = Number(read("rev-list", "--count", "--no-merges", revision).trim());
+  if (!Number.isSafeInteger(total) || total <= 0) return "";
+  const step = Math.max(1, Math.ceil(limit / 2));
+  const start = total > limit ? Math.ceil((total - limit) / step) * step : 0;
+  const raw = read("log", "-n", String(total - start), "--no-merges", "--reverse", "--date=short", GITLOG_FORMAT, revision, "--");
   return gitLogRecords(raw).join(GITLOG_DIVIDER);
 }
 
